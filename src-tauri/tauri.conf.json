{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OT-2 Config Builder",
  "version": "0.1.1",
  "identifier": "com.zhuojian.ot2-config-builder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OT-2 Config Builder",
        "width": 1120,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/zhuojianlook/ot2-config-builder/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5REVBMEY2Q0I3RTI1MjQKUldRa0pYN0w5cURlbWNHWUFRc3pvZTZpV3RiNjZaOSt5TnRUY0VkMWFMTlBiclUwQ2ltcHk0ZFEK"
    }
  }
}
